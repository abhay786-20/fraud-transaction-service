# ===========================================
# Fraud Transaction Service - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# -----------------
# App Config (Optional - has defaults)
# -----------------
# development = human-readable console logs, production = structured JSON
TRANSACTION_ENV=development

# -----------------
# Server Config (Optional - has defaults)
# -----------------
TRANSACTION_SERVER_HOST=0.0.0.0
TRANSACTION_SERVER_PORT=8082

# -----------------
# Database Config (REQUIRED)
# -----------------
TRANSACTION_DB_HOST=localhost
TRANSACTION_DB_PORT=5432
TRANSACTION_DB_USER=your_db_user
TRANSACTION_DB_PASSWORD=your_db_password
TRANSACTION_DB_NAME=your_db_name

# Database Pool Settings (Optional - has defaults)
# TRANSACTION_DB_MAX_OPEN_CONNS=25
# TRANSACTION_DB_MAX_IDLE_CONNS=25
# TRANSACTION_DB_MAX_LIFETIME_MIN=5

# -----------------
# Auth Config (REQUIRED)
# -----------------
# MUST match fraud-auth-service's AUTH_JWT_SECRET exactly — this service
# verifies tokens issued there, using a shared secret (see README).
TRANSACTION_JWT_SECRET=your_jwt_secret_key_min_32_chars
