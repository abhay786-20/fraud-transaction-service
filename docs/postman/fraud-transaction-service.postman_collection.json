{
  "info": {
    "name": "fraud-transaction-service",
    "description": "Direct-to-service collection (no gateway) for fraud-transaction-service — wallets, transactions, and the admin flag/unflag + search/filter routes. This service verifies a receiver exists by calling fraud-auth-service's internal API, so fraud-auth-service must also be running.\n\nRequests are grouped in the order a fresh reader should run them; tokens/ids are saved into collection variables automatically via Tests scripts. See ../API_FLOW.md for the same sequence as plain curl commands.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8082" },
    { "key": "auth_base_url", "value": "http://localhost:8081", "description": "only used by the setup requests in folder 0" },
    { "key": "sender_email", "value": "sender@example.com" },
    { "key": "sender_password", "value": "password123" },
    { "key": "sender_token", "value": "" },
    { "key": "sender_id", "value": "" },
    { "key": "receiver_email", "value": "receiver@example.com" },
    { "key": "receiver_password", "value": "password123" },
    { "key": "receiver_token", "value": "" },
    { "key": "receiver_id", "value": "" },
    { "key": "admin_email", "value": "admin@example.com" },
    { "key": "admin_password", "value": "change_me_before_prod" },
    { "key": "admin_token", "value": "" },
    { "key": "transaction_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup — create sender & receiver (via fraud-auth-service)",
      "item": [
        {
          "name": "Signup sender",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const b=pm.response.json(); if(pm.response.code===201) pm.collectionVariables.set('sender_id', b.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"name\": \"Sender One\",\n  \"email\": \"{{sender_email}}\",\n  \"password\": \"{{sender_password}}\"\n}" },
            "url": { "raw": "{{auth_base_url}}/signup", "host": ["{{auth_base_url}}"], "path": ["signup"] }
          }
        },
        {
          "name": "Signup receiver",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const b=pm.response.json(); if(pm.response.code===201) pm.collectionVariables.set('receiver_id', b.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"name\": \"Receiver One\",\n  \"email\": \"{{receiver_email}}\",\n  \"password\": \"{{receiver_password}}\"\n}" },
            "url": { "raw": "{{auth_base_url}}/signup", "host": ["{{auth_base_url}}"], "path": ["signup"] }
          }
        },
        {
          "name": "Login as sender",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const b=pm.response.json(); if(pm.response.code===200){ pm.collectionVariables.set('sender_token', b.token); pm.collectionVariables.set('sender_id', b.user.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"{{sender_email}}\",\n  \"password\": \"{{sender_password}}\"\n}" },
            "url": { "raw": "{{auth_base_url}}/login", "host": ["{{auth_base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login as receiver",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const b=pm.response.json(); if(pm.response.code===200){ pm.collectionVariables.set('receiver_token', b.token); pm.collectionVariables.set('receiver_id', b.user.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"{{receiver_email}}\",\n  \"password\": \"{{receiver_password}}\"\n}" },
            "url": { "raw": "{{auth_base_url}}/login", "host": ["{{auth_base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login as admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const b=pm.response.json(); if(pm.response.code===200) pm.collectionVariables.set('admin_token', b.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": { "raw": "{{auth_base_url}}/login", "host": ["{{auth_base_url}}"], "path": ["login"] },
            "description": "Requires AUTH_SEED_ADMIN_EMAIL/PASSWORD set on fraud-auth-service."
          }
        }
      ]
    },
    {
      "name": "1. Wallets",
      "item": [
        {
          "name": "Create my wallet (as sender)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{sender_token}}" }],
            "url": { "raw": "{{base_url}}/wallets", "host": ["{{base_url}}"], "path": ["wallets"] },
            "description": "Always for the caller's own account — no user_id in the body, ever. New wallets are created with is_enabled=true and balance=0."
          }
        },
        {
          "name": "Create my wallet (as receiver)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{receiver_token}}" }],
            "url": { "raw": "{{base_url}}/wallets", "host": ["{{base_url}}"], "path": ["wallets"] }
          }
        },
        {
          "name": "Top up my wallet (as sender)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sender_token}}" }
            ],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"amount\": \"1000.00\"\n}" },
            "url": { "raw": "{{base_url}}/wallets/topup", "host": ["{{base_url}}"], "path": ["wallets", "topup"] },
            "description": "Fails with 403 if the wallet is disabled (see admin routes below), 404 if it doesn't exist yet."
          }
        },
        {
          "name": "Get my wallet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sender_token}}" }],
            "url": { "raw": "{{base_url}}/wallets/me", "host": ["{{base_url}}"], "path": ["wallets", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Transactions",
      "item": [
        {
          "name": "Create a transaction (sender -> receiver)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const b=pm.response.json(); if(pm.response.code===201) pm.collectionVariables.set('transaction_id', b.id);"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sender_token}}" }
            ],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"receiver_id\": \"{{receiver_id}}\",\n  \"amount\": \"250000\"\n}" },
            "url": { "raw": "{{base_url}}/transactions", "host": ["{{base_url}}"], "path": ["transactions"] },
            "description": "sender_id always comes from the caller's JWT, never the body. This exact amount (>200,000 AND a round multiple of 10,000) trips fraud-engine-service's large_amount + round_amount rules for a total score of 50 — 'high' risk — if that service is also running, watch it show up in GET /scores over there."
          }
        },
        {
          "name": "List transactions (admin, paginated + filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/transactions?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" },
                { "key": "status", "value": "completed", "disabled": true, "description": "exact match: pending | completed | failed | flagged" },
                { "key": "search", "value": "{{transaction_id}}", "disabled": true, "description": "substring match against the transaction's own ID" },
                { "key": "user_ids", "value": "{{sender_id}}", "disabled": true, "description": "comma-separated — matches sender OR receiver; OR'd with search, not AND'd (they're two halves of one search box)" }
              ]
            }
          }
        },
        {
          "name": "Flag a transaction (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"reason\": \"Sender wallet had a suspicious rapid top-up right before this transfer\"\n}" },
            "url": { "raw": "{{base_url}}/transactions/{{transaction_id}}/flag", "host": ["{{base_url}}"], "path": ["transactions", "{{transaction_id}}", "flag"] },
            "description": "Only eligible from status='completed' — a manual call that a transaction looks fraudulent, for cases fraud-engine-service's automatic scoring missed. reason is optional (a default is used if omitted). Publishes to the SAME fraud-alerts Kafka topic the automatic scorer uses, so fraud-notification-service emails sender/receiver/every admin exactly like an automatic alert."
          }
        },
        {
          "name": "Unflag a transaction (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"reason\": \"Confirmed legitimate with the sender over a support call\"\n}" },
            "url": { "raw": "{{base_url}}/transactions/{{transaction_id}}/unflag", "host": ["{{base_url}}"], "path": ["transactions", "{{transaction_id}}", "unflag"] },
            "description": "Flag's reverse — only eligible from status='flagged'. Publishes a 'cleared' event on the same topic; fraud-notification-service sends a distinct 'reviewed and cleared' email instead of a fraud-alert one."
          }
        }
      ]
    },
    {
      "name": "3. Admin wallet management",
      "item": [
        {
          "name": "Bulk wallet status (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/wallets?user_ids={{sender_id}},{{receiver_id}}",
              "host": ["{{base_url}}"],
              "path": ["wallets"],
              "query": [{ "key": "user_ids", "value": "{{sender_id}},{{receiver_id}}" }]
            },
            "description": "One call for a whole page of user IDs instead of one GET /wallets/:id per row — this is what the admin dashboard's Users table calls. A requested ID with no wallet still gets an entry (exists:false)."
          }
        },
        {
          "name": "Disable a wallet (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"is_enabled\": false\n}" },
            "url": { "raw": "{{base_url}}/wallets/{{sender_id}}", "host": ["{{base_url}}"], "path": ["wallets", "{{sender_id}}"] },
            "description": "Freezes the wallet — Debit/Credit/AddBalance all reject it until re-enabled. Try the 'Top up my wallet' request again after this: it now 403s."
          }
        },
        {
          "name": "Re-enable a wallet (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } }, "raw": "{\n  \"is_enabled\": true\n}" },
            "url": { "raw": "{{base_url}}/wallets/{{sender_id}}", "host": ["{{base_url}}"], "path": ["wallets", "{{sender_id}}"] }
          }
        }
      ]
    }
  ]
}
